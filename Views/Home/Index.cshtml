@model FarmaciaMVC.Models.DashboardViewModel
@{
    ViewData["Title"] = "Resumen";
}

<div class="dashboard">
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Farmacia Vida, inicio">
            <span class="brand-mark">+</span>
            <span class="brand-copy"><strong>farmacia</strong><small>VIDA</small></span>
        </a>

        <div class="sidebar-label">MENÚ PRINCIPAL</div>
        <nav class="side-nav" aria-label="Navegación principal">
            <a class="side-link is-active" asp-controller="Home" asp-action="Index">
                <span class="side-icon">⌂</span> Resumen
            </a>
            <a class="side-link" href="#clientes">
                <span class="side-icon">♙</span> Clientes
            </a>
            <a class="side-link" href="#ventas">
                <span class="side-icon">▤</span> Ventas
            </a>
        </nav>

        <div class="sidebar-bottom">
            <div class="help-card">
                <span class="help-icon">?</span>
                <strong>¿Necesitas ayuda?</strong>
                <p>Consulta la guía de uso de tu farmacia.</p>
                <a asp-controller="Home" asp-action="Privacy">Ver información <span aria-hidden="true">→</span></a>
            </div>
            <div class="profile">
                <div class="profile-avatar">FA</div>
                <div class="profile-copy"><strong>Farmacia Vida</strong><small>Panel de administración</small></div>
                <span class="profile-menu" aria-hidden="true">···</span>
            </div>
        </div>
    </aside>

    <main class="main-panel">
        <header class="topbar">
            <div class="breadcrumb"><span>Farmacia Vida</span><span class="breadcrumb-separator">/</span><strong>Resumen</strong></div>
            <div class="topbar-right">
                <span class="today-label">@DateTime.Now.ToString("dddd, d 'de' MMMM", new System.Globalization.CultureInfo("es"))</span>
                <div class="topbar-avatar" aria-label="Farmacia Vida">FA</div>
            </div>
        </header>

        <div class="content">
            <section class="welcome-row">
                <div>
                    <p class="eyebrow">PANEL DE CONTROL</p>
                    <h1>¡Hola! <span class="wave">✦</span></h1>
                    <p class="welcome-subtitle">Aquí tienes el resumen de tu farmacia.</p>
                </div>
                <a class="button button-primary" href="#ventas"><span class="button-plus">+</span> Ver ventas</a>
            </section>

            @if (Model.IsDemo)
            {
                <div class="demo-notice" role="status">
                    <span class="demo-dot"></span>
                    Vista de demostración <span>·</span> Configura PostgreSQL para mostrar datos reales.
                </div>
            }

            <section class="metrics-grid" aria-label="Indicadores de la farmacia">
                <article class="metric-card">
                    <div class="metric-heading"><span>Ventas de hoy</span><span class="metric-icon mint">↗</span></div>
                    <div class="metric-value">@Model.TodaySales.ToString("C", new System.Globalization.CultureInfo("es-DO"))</div>
                    <div class="metric-foot"><span class="metric-caption">Total registrado hoy</span></div>
                </article>
                <article class="metric-card">
                    <div class="metric-heading"><span>Transacciones</span><span class="metric-icon lilac">▤</span></div>
                    <div class="metric-value">@Model.TodayTransactions</div>
                    <div class="metric-foot"><span class="metric-caption">Ventas realizadas hoy</span></div>
                </article>
                <article class="metric-card">
                    <div class="metric-heading"><span>Clientes activos</span><span class="metric-icon peach">♙</span></div>
                    <div class="metric-value">@Model.ActiveCustomers</div>
                    <div class="metric-foot"><span class="metric-caption">En tu registro de clientes</span></div>
                </article>
                <article class="metric-card">
                    <div class="metric-heading"><span>Ventas del mes</span><span class="metric-icon blue">▥</span></div>
                    <div class="metric-value">@Model.MonthSales.ToString("C", new System.Globalization.CultureInfo("es-DO"))</div>
                    <div class="metric-foot"><span class="metric-caption">Acumulado mensual</span></div>
                </article>
            </section>

            <section class="section-card sales-card" id="ventas">
                <div class="section-heading">
                    <div><h2>Ventas recientes</h2><p>Actividad de ventas de tu farmacia</p></div>
                    <label class="search-box">
                        <span class="search-icon" aria-hidden="true">⌕</span>
                        <input id="sales-search" type="search" placeholder="Buscar venta o cliente" aria-label="Buscar venta o cliente" />
                    </label>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>VENTA</th><th>CLIENTE</th><th>FECHA Y HORA</th><th>ESTADO</th><th class="amount-cell">TOTAL</th></tr></thead>
                        <tbody id="sales-table">
                            @foreach (var sale in Model.RecentSales)
                            {
                                <tr data-search="@($"{sale.Reference} {sale.CustomerName}".ToLowerInvariant())">
                                    <td><span class="sale-reference">@sale.Reference</span></td>
                                    <td><span class="customer-name">@sale.CustomerName</span></td>
                                    <td class="muted-cell">@sale.SoldAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt", new System.Globalization.CultureInfo("es-DO"))</td>
                                    <td><span class="status-pill">@sale.Status</span></td>
                                    <td class="amount-cell total-cell">@sale.Total.ToString("C", new System.Globalization.CultureInfo("es-DO"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="empty-state" id="sales-empty" hidden>No hay ventas que coincidan con la búsqueda.</p>
                </div>
            </section>

            <section class="section-card customers-card" id="clientes">
                <div class="section-heading">
                    <div><h2>Clientes recientes</h2><p>Personas que forman parte de tu comunidad</p></div>
                    <label class="search-box customer-search">
                        <span class="search-icon" aria-hidden="true">⌕</span>
                        <input id="customers-search" type="search" placeholder="Buscar cliente" aria-label="Buscar cliente" />
                    </label>
                </div>
                <div class="table-wrap">
                    <table class="data-table customer-table">
                        <thead><tr><th>CLIENTE</th><th>CORREO ELECTRÓNICO</th><th>ÚLTIMA COMPRA</th><th></th></tr></thead>
                        <tbody id="customers-table">
                            @foreach (var customer in Model.RecentCustomers)
                            {
                                <tr data-search="@($"{customer.Name} {customer.Email}".ToLowerInvariant())">
                                    <td>
                                        <div class="customer-cell">
                                            <span class="customer-avatar @customer.AvatarColor">@customer.Initials</span>
                                            <span class="customer-name">@customer.Name</span>
                                        </div>
                                    </td>
                                    <td class="muted-cell">@customer.Email</td>
                                    <td class="muted-cell">@(customer.LastPurchase?.ToLocalTime().ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-DO")) ?? "Sin compras")</td>
                                    <td class="customer-arrow">→</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="empty-state" id="customers-empty" hidden>No hay clientes que coincidan con la búsqueda.</p>
                </div>
            </section>

            <footer class="page-footer">Farmacia Vida <span>·</span> Gestión sencilla para cuidar mejor.</footer>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        (() => {
            const connectSearch = (inputId, tableId, emptyId) => {
                const input = document.getElementById(inputId);
                const table = document.getElementById(tableId);
                const empty = document.getElementById(emptyId);
                const rows = [...table.querySelectorAll("tr")];

                input.addEventListener("input", () => {
                    const query = input.value.trim().toLocaleLowerCase();
                    let visibleCount = 0;
                    rows.forEach(row => {
                        const matches = row.dataset.search.includes(query);
                        row.hidden = !matches;
                        if (matches) visibleCount++;
                    });
                    empty.hidden = visibleCount > 0;
                });
            };

            connectSearch("sales-search", "sales-table", "sales-empty");
            connectSearch("customers-search", "customers-table", "customers-empty");
        })();
    </script>
}
